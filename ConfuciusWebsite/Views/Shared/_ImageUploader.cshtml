@using ConfuciusWebsite.ViewModels.EventViewModels
@model List<ImageOption>

<!--DROP MENU FOR IMAGES-->
<div class="col-12">
    <label class="form-label">Images</label>

    <div id="dropzone" class="border border-2 border-secondary rounded p-5 text-center"
            style="cursor: pointer; background-color: #f8f9fa; min-height: 150px;">
        <p class="mb-0">Drag & drop images here, or click to select</p>
    </div>

    <input type="file" id="fileInput" name="Images" multiple accept="image/*" class="d-none" />
</div>

<!-- Preview area -->
<div id="preview" class="mt-3 d-flex flex-wrap gap-3"></div>

<!-- EXISTING images (database) -->
@if (Model != null && Model.Any())
{
    <div id="existing-images" class="d-flex flex-wrap gap-3 mb-3">
        @foreach (var img in Model)
        {
            <div style="position: relative;">
                <img src="@img.FilePath"
                     style="width: 120px; height: 120px; object-fit: cover;"
                     class="rounded shadow-sm" />

                <button type="button"
                        class="btn btn-danger btn-sm delete-existing-image"
                        style="position: absolute; top: 0; right: 0; border-radius: 50%;"
                        data-image-id="@img.Id">
                    ×
                </button>
            </div>
        }
    </div>
}