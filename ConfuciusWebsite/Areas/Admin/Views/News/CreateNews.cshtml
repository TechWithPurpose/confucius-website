@using ConfuciusWebsite.ViewModels.NewsViewModels
@model NewsEdit
@{
    ViewData["Title"] = "Create News";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mb-4">Create News</h2>

<form asp-action="CreateNews" method="post" enctype="multipart/form-data" class="row g-3">
    @Html.AntiForgeryToken()
    @await Html.PartialAsync("_NewsForm", Model)
</form>

@section Scripts {
    <script type="module">
        import { initImageUploader } from '/js/imageUploader.js';
        initImageUploader({
            dropzoneId: "dropzone",
            fileInputId: "fileInput",
            previewId: "preview",
            formSelector: "form"
        });
    </script>
}
